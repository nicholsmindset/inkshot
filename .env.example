PORT=3001
APP_ORIGIN=http://localhost:5173
# Local development uses durable embedded PostgreSQL. Set DATABASE_URL for hosted PostgreSQL.
DATABASE_URL=
DATA_DIR=./data
# Mock mode never calls a paid generation provider.
GENERATION_MODE=mock
HF_API_KEY_ID=
HF_API_KEY_SECRET=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GENERATION_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
# Live generation is deliberately opt-in. See README for remaining launch requirements.
ALLOW_LIVE_GENERATION=false
# Optional subscription testing. Only a dedicated Stripe sandbox is supported.
ENABLE_BILLING_SANDBOX=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# An active recurring sandbox Price for $39 USD/month.
STRIPE_STUDIO_PRICE_ID=
