PORT=3001
APP_ORIGIN=http://localhost:5173
# Local development uses durable embedded PostgreSQL. Set DATABASE_URL for hosted PostgreSQL.
DATABASE_URL=
DATA_DIR=./data
# Mock mode never calls a paid generation provider.
GENERATION_MODE=mock
HF_API_KEY_ID=
HF_API_KEY_SECRET=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GENERATION_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
# Live generation is deliberately opt-in. See README for remaining launch requirements.
ALLOW_LIVE_GENERATION=false
# Optional subscription testing. Only a dedicated Stripe sandbox is supported.
ENABLE_BILLING_SANDBOX=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# An active recurring sandbox Price (the primary currency; see PLAN_PRICES below).
STRIPE_STUDIO_PRICE_ID=

# Positive daily paid writing request ceilings, in UTC. Required in live mode.
WRITING_DAILY_REQUEST_LIMIT=
WRITING_WORKSPACE_DAILY_REQUEST_LIMIT=

# Protected operations status and optional structured alerts for a log drain.
# Use a separately generated high-entropy bearer secret; never expose it to clients.
CRON_SECRET=
OPS_ALERTS_ENABLED=false
# New campaign video duration, frozen when the draft is first saved (3–15 seconds).
VIDEO_DURATION_SECONDS=10
# Optional signed provider callbacks; polling remains available.
HF_WEBHOOKS_ENABLED=false
HF_WEBHOOK_SECRET=
# Enable only after hosted deletion acceptance and owner policy review.
# Shared Auth/live-schema deployments refuse self-service deletion.
ENABLE_ACCOUNT_DELETION=false

# Optional independent writing control. Unset preserves GENERATION_MODE behaviour.
# Preview AI writing requires BOTH live and true plus provider credentials and daily limits.
# Does not enable media generation or billing. Leave off until a capped trial is approved.
WRITING_MODE=mock
ALLOW_LIVE_WRITING=false

# --- Pricing and pilot (see LAUNCH_CHECKLIST.md and docs/CUTOVER.md) ---
# Multi-currency prices in minor units, primary currency named by PLAN_CURRENCY.
PLAN_CURRENCY=usd
PLAN_PRICES=
# Live Stripe price IDs by currency, e.g. usd:price_...,sgd:price_... (STRIPE_STUDIO_PRICE_ID is the primary currency's legacy form).
STRIPE_PRICE_IDS=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_MODE=off
ENABLE_LIVE_CHECKOUT=false
GENERATION_PAUSED=false
VIDEO_REGEN_MONTHLY_CAP=8
PILOT_INVITE_ONLY=false
DEFAULT_MARKET=SG
SUPPORT_EMAIL=
COPY_PLATFORMS=facebook,instagram,tiktok
COPY_MAX_RUNS_PER_PLATFORM=3
ENABLE_EXPORT_REVIEW=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
# Hosted only (Vercel): AUTH_PROVIDER=supabase STORAGE_PROVIDER=supabase INKSHOT_SHARED_PROJECT_LIVE=false
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY: set in the host's secret store, never in this file.
